"ίδια σαφήνεια."

#: includes/admin-page.php:301
msgid "Stock and backorder aware"
msgstr "Λαμβάνει υπόψη απόθεμα και backorders"

#: includes/admin-page.php:301
msgid "Business days, cutoff time, and holidays"
msgstr "Εργάσιμες ημέρες, ώρα λήξης και αργίες"

