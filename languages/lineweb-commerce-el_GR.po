"custom template."

#: includes/auto-placements.php:172
msgid "Show Delivery Estimate after the add-to-cart area on physical product pages."
msgstr ""
"Εμφάνιση Εκτίμησης παράδοσης μετά την περιοχή προσθήκης στο καλάθι στις "
